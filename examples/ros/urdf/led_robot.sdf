      </led>
      <startup_mode>idle</startup_mode>
      <mode name='idle'>
        <step always_on='false'>
          <color>0 1 1 1</color>
          <on_time>1.0</on_time>
          <intensity>2.0</intensity>
        </step>
        <step always_on='false'>
          <color>1 1 1 1</color>
          <on_time>1.0</on_time>
          <intensity>0.0</intensity>
        </step>
      </mode>
      <mode name='emergency'>
        <step always_on='false'>
          <color>1 0 0 1</color>
          <on_time>1.0</on_time>
          <intensity>2.0</intensity>
        </step>
        <step always_on='false'>
          <color>1 1 1 1</color>
          <on_time>1.0</on_time>
          <intensity>0.0</intensity>
        </step>
      </mode>
      <mode name='front_navigation'>
        <active_leds>
          <led>front_led</led>
        </active_leds>
        <step always_on='true'>
          <color>0 1 1 1</color>
        </step>
      </mode>
      <mode name='reverse_navigation'>
        <active_leds>
          <led>back_led</led>
        </active_leds>
        <step always_on='true'>
          <color>0 1 1 1</color>
        </step>
      </mode>
    </plugin>
